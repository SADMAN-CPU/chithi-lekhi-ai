# ══════════════════════════════════════════════════════════════════════════════
# CHITHI LEKHI AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` for local development.
# Set these variables in the Vercel Project Dashboard (Settings > Environment Variables)
# ══════════════════════════════════════════════════════════════════════════════

# ── Application URL ────────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Production: https://chithi.ai (or your Vercel deployment URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI API Configuration (Google Gemini & OpenAI) ─────────────────────────────
# Google Gemini API Key (Recommended for human emotional Bengali prose)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional fallback)
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ── Supabase Configuration ────────────────────────────────────────────────────
# Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-jwt-key-here

# Optional: Service Role Key for administrative tasks (server-only)
# NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Admin Panel Security & Role-Based Access Control (RBAC) ───────────────────
# Primary SaaS RBAC: Any registered user promoted in Supabase Auth will have admin rights.
# In Supabase SQL Editor, run:
#   UPDATE public.profiles SET role = 'admin' WHERE email = 'admin@chithi.ai';
#
# Fallback / Master Emergency Admin Credentials:
ADMIN_EMAIL=admin@chithi.ai
# Raw password OR SHA-256 hash (recommended for production: echo -n "pass" | shasum -a 256)
ADMIN_PASSWORD=your_secure_admin_password_here
# ADMIN_PASSWORD_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
# Random string for signing admin session cookies (min 32 chars)
ADMIN_SESSION_SECRET=chithi_admin_super_secret_session_key_2026_random_string_here

